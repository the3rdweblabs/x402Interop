# Live canary (examples/live-canary). Mainnet, opt-in.
# Quote-only until CANARY_SEND and CANARY_CONFIRM are both set. Automatic
# sending works for EVM origins only. There is no NEAR Intents testnet.

# --- The swap ---------------------------------------------------------------
# CANARY_ORIGIN_NETWORK=base
# CANARY_DEST_NETWORK=sui:mainnet
# CANARY_ORIGIN_ASSET=USDC
# CANARY_DEST_ASSET=USDC
# CANARY_AMOUNT=200000
# CANARY_SWAP_TYPE=EXACT_OUTPUT
# CANARY_DEPOSIT_TYPE=ORIGIN_CHAIN
# CANARY_DELIVERY_MODE=on_deposit
# Slippage sent to 1Click, in basis points. 100 = 1%.
# CANARY_SLIPPAGE_BPS=100

# --- Who pays and who receives ----------------------------------------------
# The origin address is optional when an EVM private key is set.
# CANARY_ORIGIN_ADDRESS=
# CANARY_ORIGIN_PRIVATE_KEY=
# CANARY_ORIGIN_RPC_URL=
# CANARY_DEST_ADDRESS=

# --- Whether money moves ----------------------------------------------------
# Both must be set, together, before a send. Empty CANARY_WAIT follows
# CANARY_SEND, so a send also waits for the terminal status.
# CANARY_SEND=false
# CANARY_CONFIRM=
# CANARY_WAIT=
# CANARY_QUOTE_DRY=false

# --- How long to wait -------------------------------------------------------
# CANARY_POLL_INTERVAL_SECONDS=10
# CANARY_POLL_TIMEOUT_SECONDS=600
# CANARY_ONECLICK_BASE_URL=https://1click.chaindefuser.com
# CANARY_RESOURCE_URL=https://example.invalid/x402interop/canary
