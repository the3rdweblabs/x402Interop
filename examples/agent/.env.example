# Example buyer (examples/agent). Copy to examples/agent/.env.

# --- Mode -------------------------------------------------------------------
# test: signs a payload. The simulated resource settles it. Nothing is broadcast.
# live: broadcasts a real origin transfer to the 1Click deposit address.
# There is no NEAR Intents testnet, so live is mainnet.
MODE=test
RESOURCE_BASE_URL=http://127.0.0.1:4040

# --- Model ------------------------------------------------------------------
# Any OpenAI-compatible endpoint. The key stays in this file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ORG=
OPENAI_PROJECT=
OPENAI_TEMPERATURE=0
OPENAI_MAX_TOKENS=1200

# --- Origin wallet ----------------------------------------------------------
# The key, the chain, and the asset are one wallet. EVM is the implemented
# family. 0x key required in MODE=live. ORIGIN_ADDRESS is derived when empty.
ORIGIN_FAMILY=evm
ORIGIN_NETWORK=eip155:8453
ORIGIN_ASSET=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913
ORIGIN_ASSET_ID=nep141:base-0x833589fcd6edb6e08f4c7c32d4f71b54bda02913.omft.near
ORIGIN_PRIVATE_KEY=
ORIGIN_RPC_URL=
ORIGIN_ADDRESS=

# --- Spend gate -------------------------------------------------------------
# MODE=live broadcasts only when CONFIRM_SPEND=true, and only up to
# MAX_SPEND_ATOMIC of the origin asset.
CONFIRM_SPEND=true
MAX_SPEND_ATOMIC=500000
