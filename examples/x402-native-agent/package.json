{
  "name": "x402-native-agent",
  "version": "0.0.0",
  "description": "Example of x402-native agent using @x402/fetch with x402Interop scheme client",
  "license": "GPL-3.0-or-later",
  "author": "The3rdWebLabs",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/esm/index.js"
  },
  "dependencies": {
    "@x402/fetch": "^2.28.0",
    "@x402/core": "^2.28.0",
    "@x402interop/scheme-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "private": true
}
