# Marketplace. Public values only. They are inlined at build time, so rebuild
# after a change. Never put an API key, a JWT, or a relayer secret here.

# --- This site and the two hosts it calls ----------------------------------
# All three belong to one environment: local Caddy, x402interop.xyz, or Railway.
# Local Caddy (see the root Caddyfile):
PUBLIC_SITE_URL=https://marketplace.x402interop.localhost:8443
PUBLIC_FACILITATOR_URL=https://facilitator.x402interop.localhost:8443
PUBLIC_DOCS_URL=https://docs.x402interop.localhost:8443
# Direct preview, no Caddy:
# PUBLIC_SITE_URL=http://localhost:4321
# PUBLIC_FACILITATOR_URL=http://127.0.0.1:4020
# PUBLIC_DOCS_URL=http://127.0.0.1:4322

# --- Build gate -------------------------------------------------------------
# Set when publishing. The build stops if any PUBLIC_* URL above is missing.
# X402_ENV=production

# x402interop.xyz:
# PUBLIC_SITE_URL=https://marketplace.x402interop.xyz
# PUBLIC_FACILITATOR_URL=https://facilitator.x402interop.xyz
# PUBLIC_DOCS_URL=https://docs.x402interop.xyz
# Railway, each name is that service's *.up.railway.app host.
# See deploy/Caddyfile.railway.
