{
  "name": "facilitator",
  "version": "0.0.0",
  "description": "HTTP facilitator with /verify, /settle, and /supported routes.",
  "license": "GPL-3.0-or-later",
  "author": "THE3RDWEBLABS",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the3rdweblabs/x402Interop.git",
    "directory": "apps/facilitator"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:check": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "start": "node dist/esm/cli.js"
  },
  "dependencies": {
    "@x402/core": "^2.28.0",
    "@x402interop/core": "workspace:*",
    "@x402interop/evm": "workspace:*",
    "@x402interop/facilkit": "workspace:*",
    "@x402interop/intents": "workspace:*",
    "@x402interop/lightning": "workspace:*",
    "@x402interop/near": "workspace:*",
    "@x402interop/quote": "workspace:*",
    "@x402interop/schemes": "workspace:*",
    "@x402interop/status": "workspace:*",
    "@x402interop/sui": "workspace:*",
    "@x402interop/svm": "workspace:*",
    "@x402interop/ton": "workspace:*",
    "@x402interop/tron": "workspace:*",
    "@x402interop/xrpl": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@typescript/typescript6": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "private": true
}
