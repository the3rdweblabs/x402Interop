# Facilitator. Copy to apps/facilitator/.env. Never commit the copy.
# Secrets stay in this process. The marketplace only needs PUBLIC_FACILITATOR_URL.

# --- Process ----------------------------------------------------------------
# Production refuses to start unless storage is postgres.
NODE_ENV=production
FACILITATOR_PORT=4020
FACILITATOR_STORAGE=postgres

# --- Marketplace this API serves --------------------------------------------
# CORS is the browser origin. MARKETPLACE_DOMAIN is the host written into
# wallet sign-in messages. They name the same marketplace.
# Local Caddy (see the root Caddyfile):
FACILITATOR_CORS_ORIGINS=https://marketplace.x402interop.localhost:8443
MARKETPLACE_DOMAIN=marketplace.x402interop.localhost:8443
# Direct preview, no Caddy:
# FACILITATOR_CORS_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
# MARKETPLACE_DOMAIN=localhost:4321
# x402interop.xyz:
# FACILITATOR_CORS_ORIGINS=https://marketplace.x402interop.xyz
# MARKETPLACE_DOMAIN=marketplace.x402interop.xyz
# Railway (see deploy/Caddyfile.railway):
# FACILITATOR_CORS_ORIGINS=https://x402interop-marketplace.up.railway.app
# MARKETPLACE_DOMAIN=x402interop-marketplace.up.railway.app

# --- Who may write listings -------------------------------------------------
# Comma-separated key=owner. Empty means no authenticated writes.
X402INTEROP_API_KEYS=
# Use one of these, never both. Free listings while the fee table is empty.
MARKETPLACE_FREE_LISTINGS=true
MARKETPLACE_FEES_JSON=

# --- Where quotes and listings are stored ----------------------------------
# DATABASE_URL is required when FACILITATOR_STORAGE=postgres.
# FACILITATOR_STORE_PATH is the JSON file used when storage is file.
# Compose reads the POSTGRES_* four. DATABASE_URL must name that same database.
DATABASE_URL=
FACILITATOR_STORE_PATH=
POSTGRES_USER=x402interop
POSTGRES_PASSWORD=
POSTGRES_DB=x402interop
POSTGRES_PORT=5433

# --- NEAR Intents / 1Click --------------------------------------------------
# live, sdk, and auto require ONECLICK_API_KEY. mock and simulator do not.
X402INTEROP_INTENTS_CLIENT=live
ONECLICK_API_KEY=
ONE_CLICK_API_URL=https://1click.chaindefuser.com
# Slippage sent to 1Click, in basis points. 100 = 1%.
SLIPPAGE_BPS=100

# --- Exact settlement -------------------------------------------------------
# Families: sui, svm, near, stellar. A family is advertised only when its
# endpoint, and its relayer where one is required, are set.
# Sui needs the RPC only. Solana, NEAR, and Stellar also need a funded key.
EXACT_FAMILIES=sui,svm,near,stellar
RPC_URL_SUI_MAINNET=https://fullnode.mainnet.sui.io:443
RPC_URL_SOLANA_MAINNET=https://api.mainnet-beta.solana.com
RPC_URL_NEAR_MAINNET=https://rpc.mainnet.fastnear.com
RPC_URL_STELLAR_MAINNET=https://horizon.stellar.org
RELAYER_KEY_SOLANA_MAINNET=
NEAR_RELAYER_ACCOUNT_ID=
RELAYER_KEY_NEAR_MAINNET=
RELAYER_KEY_STELLAR_MAINNET=

# --- Limits -----------------------------------------------------------------
# Empty RATE_LIMIT_MAX disables the limiter. Exposure caps are atomic units
# of on_deposit, per network and asset.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=
EXPOSURE_LIMIT_PER_BUYER=
EXPOSURE_LIMIT_PER_SELLER=

# --- Names kept, not read ---------------------------------------------------
# Nothing in this process loads the names below. They stay so a later worker
# does not have to invent a new spelling.
REDIS_URL=
BACKUP_BUCKET=
ENABLED_CORRIDORS=
RPC_URL_BASE_MAINNET=
RPC_URL_BASE_TESTNET=
RPC_URL_ETHEREUM_MAINNET=
RPC_URL_ARBITRUM_MAINNET=
RPC_URL_POLYGON_MAINNET=
RPC_URL_SUI_TESTNET=
RPC_URL_NEAR_TESTNET=
RPC_URL_TON_MAINNET=
RPC_URL_TRON_MAINNET=
RPC_URL_XRPL_MAINNET=
RELAYER_KEY_BASE_MAINNET=
RELAYER_KEY_BASE_TESTNET=
WEBHOOK_SIGNING_SECRET=
LIGHTNING_NODE_URL_MAINNET=
LIGHTNING_MACAROON_MAINNET=
