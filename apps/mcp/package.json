{
  "name": "mcp",
  "version": "0.0.0",
  "description": "Stub MCP server that registers the x402interop agent tools.",
  "license": "GPL-3.0-or-later",
  "author": "THE3RDWEBLABS",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the3rdweblabs/x402Interop.git",
    "directory": "apps/mcp"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:check": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "start": "node dist/esm/cli.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@typescript/typescript6": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "private": true
}
