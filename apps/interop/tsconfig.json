{
  "extends": "astro/tsconfigs/base",
  "include": [".astro/types.d.ts", "src"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "types": ["node", "astro/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  }
}
