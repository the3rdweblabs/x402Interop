import { docSlugs } from '../../lib/doc-paths'

export async function getStaticPaths() {
  const slugs = await docSlugs('specs')
  return slugs.map((slug) => ({ params: { slug } }))
}

const slug = Astro.params.slug
if (!slug) throw new Error('Missing spec slug')
return Astro.redirect(`/docs/specs/${slug}`)
---
