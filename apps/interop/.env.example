# Main site and docs. One build serves both. Public values only.
# They are inlined at build time, so rebuild after a change.

# --- This site and the hosts it links to -----------------------------------
# The docs host is this same build. The marketplace is the other app.
# Local Caddy (see the root Caddyfile):
PUBLIC_SITE_URL=https://x402interop.localhost:8443
PUBLIC_DOCS_URL=https://docs.x402interop.localhost:8443
PUBLIC_MARKETPLACE_URL=https://marketplace.x402interop.localhost:8443
# Direct preview, no Caddy:
# PUBLIC_SITE_URL=http://localhost:4322
# PUBLIC_DOCS_URL=http://localhost:4322
# PUBLIC_MARKETPLACE_URL=http://127.0.0.1:4321

# --- Build gate -------------------------------------------------------------
# Set when publishing. The build stops if PUBLIC_SITE_URL or PUBLIC_DOCS_URL
# is missing. PUBLIC_MARKETPLACE_URL falls back to http://127.0.0.1:4321.
# X402_ENV=production

# x402interop.xyz:
# PUBLIC_SITE_URL=https://x402interop.xyz
# PUBLIC_DOCS_URL=https://docs.x402interop.xyz
# PUBLIC_MARKETPLACE_URL=https://marketplace.x402interop.xyz
# Railway, each name is that service's *.up.railway.app host.
# See deploy/Caddyfile.railway.
