{
  "name": "e2e",
  "version": "0.0.0",
  "description": "End-to-end checks against the scaffold facilitator.",
  "license": "GPL-3.0-or-later",
  "author": "The3rdWebLabs",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the3rdweblabs/x402Interop.git",
    "directory": "tests/e2e"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:check": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --coverage"
  },
  "dependencies": {
    "facilitator": "workspace:*",
    "@x402interop/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "private": true
}
