{
  "name": "@x402interop/servers",
  "version": "1.0.0",
  "description": "Seller framework bindings (express, hono, fastify, next) for the x402interop payment middleware.",
  "license": "GPL-3.0-or-later",
  "author": "THE3RDWEBLABS",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js",
      "require": "./dist/hono.cjs"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js",
      "require": "./dist/fastify.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the3rdweblabs/x402Interop.git",
    "directory": "packages/servers"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:check": "eslint . --max-warnings 0",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@x402interop/adpt": "workspace:*",
    "@x402interop/core": "workspace:*"
  },
  "peerDependencies": {
    "@x402/express": "^2.29.0",
    "@x402/fastify": "^2.30.0",
    "@x402/hono": "^2.30.0",
    "@x402/next": "^2.29.0",
    "express": ">=4.18",
    "fastify": ">=4",
    "hono": ">=4",
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "@x402/express": {
      "optional": true
    },
    "@x402/fastify": {
      "optional": true
    },
    "@x402/hono": {
      "optional": true
    },
    "@x402/next": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@typescript/typescript6": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@x402/express": "^2.29.0",
    "@x402/fastify": "^2.30.0",
    "@x402/hono": "^2.30.0",
    "@x402/next": "^2.29.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
