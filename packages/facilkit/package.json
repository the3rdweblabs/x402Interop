{
  "name": "@x402interop/facilkit",
  "version": "1.0.0",
  "description": "Shared verify, settle, and supported helpers for a facilitator.",
  "license": "GPL-3.0-or-later",
  "author": "THE3RDWEBLABS",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the3rdweblabs/x402Interop.git",
    "directory": "packages/facilkit"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:check": "eslint . --max-warnings 0",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@mysten/sui": "^2.39.1",
    "@x402/core": "^2.29.0",
    "@x402interop/adpt": "workspace:*",
    "@x402interop/core": "workspace:*",
    "@x402interop/intents": "workspace:*",
    "pg": "^8.16.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.15.5",
    "@typescript/native": "catalog:",
    "@typescript/typescript6": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "publishConfig": {
    "access": "public"
  }
}
