# [native]
# Copy to .env. Never commit real keys. The 1Click JWT stays on the server.

# Facilitator
FACILITATOR_PORT=4020
DISCOVERY_PORT=4021
EXPLORER_PORT=4022

# NEAR Intents 1Click. There is no testnet; keep amounts small.
ONE_CLICK_API_URL=https://1click.chaindefuser.com
ONE_CLICK_JWT=

DATABASE_URL=
ENABLED_CORRIDORS=eip155:8453->sui:mainnet,eip155:8453->near:mainnet

# Per-network RPC endpoints. Suffixes mark the network.
RPC_URL_BASE_MAINNET=
RPC_URL_BASE_TESTNET=
RPC_URL_ETHEREUM_MAINNET=
RPC_URL_ARBITRUM_MAINNET=
RPC_URL_POLYGON_MAINNET=
RPC_URL_SOLANA_MAINNET=
RPC_URL_SUI_MAINNET=
RPC_URL_SUI_TESTNET=
RPC_URL_NEAR_MAINNET=
RPC_URL_NEAR_TESTNET=
RPC_URL_TON_MAINNET=
RPC_URL_TRON_MAINNET=
RPC_URL_XRPL_MAINNET=

# Relayer keys that pay origin-chain gas. Use a secrets manager in deployment.
RELAYER_KEY_BASE_MAINNET=
RELAYER_KEY_BASE_TESTNET=
RELAYER_KEY_NEAR_MAINNET=

EXPOSURE_LIMIT_PER_BUYER=
EXPOSURE_LIMIT_PER_SELLER=
WEBHOOK_SIGNING_SECRET=

# Lightning is payer-only top-up credit. Leave empty until that path is built.
LIGHTNING_NODE_URL_MAINNET=
LIGHTNING_MACAROON_MAINNET=
